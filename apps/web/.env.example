# Copy to .env.local and fill in values for local development.
# Never commit .env.local — it is gitignored.

# URL of the deployed Cloudflare Worker (no trailing slash).
# Get this after running: pnpm --filter aph-proxy deploy
VITE_API_BASE=https://aph-proxy.jvega019.workers.dev

# VITE_APP_VERSION is injected automatically from package.json by vite.config.ts.
# Do not set it here unless overriding.

# Commit SHA shown on the Status page.
# vite.config.ts will call `git rev-parse --short HEAD` as a fallback for local
# builds, so this only needs to be set explicitly in CI environments that do not
# have a full git history (shallow clones, docker builds, etc.).
# In Cloudflare Pages: add a build environment variable:
#   VITE_COMMIT_SHA = $CF_PAGES_COMMIT_SHA
# VITE_COMMIT_SHA=abc1234
