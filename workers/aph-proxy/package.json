{
  "name": "aph-proxy",
  "version": "0.15.0",
  "private": true,
  "description": "Cloudflare Worker: CORS-enabled, cached proxy for Australian Parliament House RSS feeds.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "lint": "echo 'no lint configured' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/threads.test.mjs && node --experimental-strip-types tests/archive.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260424.1",
    "typescript": "5.7.2",
    "wrangler": "4.113.0"
  }
}
